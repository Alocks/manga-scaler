{
  "manifest_version": 3,
  "name": "Manga Scaler",
  "version": "1.0",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["*://*.nhentai.net/*", "*://nhentai.net/*", "*://*.comix.to/*", "*://comix.to/*", "*://*.wowpic2.store/*", "*://mangadex.org/*", "*://*.mangadex.org/*", "*://mangakakalot.gg/*", "*://*.mangakakalot.gg/*", "*://manganato.gg/*", "*://*.manganato.gg/*", "*://2xstorage.com/*", "*://*.2xstorage.com/*", "*://atsu.moe/*", "*://*.atsu.moe/*", "*://cdn.atsu.moe/*", "*://*.cdn.atsu.moe/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manga Scaler"
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "node_modules/onnxruntime-web/dist/*",
        "src/workers/*"
      ],
      "matches": [
        "*://*.nhentai.net/*",
        "*://nhentai.net/*",
        "*://*.comix.to/*",
        "*://comix.to/*",
        "*://mangadex.org/*",
        "*://*.mangadex.org/*",
        "*://mangakakalot.gg/*",
        "*://*.mangakakalot.gg/*",
        "*://manganato.gg/*",
        "*://*.manganato.gg/*",
        "*://atsu.moe/*",
        "*://*.atsu.moe/*",
        "*://cdn.atsu.moe/*",
        "*://*.cdn.atsu.moe/*"
      ]
    }
  ],
  "content_scripts": [{
    "matches": ["*://*.nhentai.net/*", "*://nhentai.net/*", "*://*.comix.to/*", "*://comix.to/*", "*://mangadex.org/*", "*://*.mangadex.org/*", "*://mangakakalot.gg/*", "*://*.mangakakalot.gg/*", "*://manganato.gg/*", "*://*.manganato.gg/*", "*://atsu.moe/*", "*://*.atsu.moe/*", "*://cdn.atsu.moe/*", "*://*.cdn.atsu.moe/*"],
    "js": [
      "./node_modules/anime4k-webgpu/lib/index.js",
      "./node_modules/anime4k-webgl/anime4k.js",
      "./node_modules/onnxruntime-web/dist/ort.all.min.js",
      "content.js",
      "src/runtime/runtime.bundle.js"
    ],
    "run_at": "document_idle"
  }]
}